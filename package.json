{
  "name": "governance-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "worker:once": "tsx --env-file-if-exists=.env scripts/worker.ts --once",
    "analysis-worker": "tsx --env-file-if-exists=.env scripts/analysis-worker.ts",
    "analysis-worker:once": "tsx --env-file-if-exists=.env scripts/analysis-worker.ts --once",
    "index:retry": "tsx --env-file-if-exists=.env scripts/index.ts retry",
    "index:rebuild": "tsx --env-file-if-exists=.env scripts/index.ts rebuild",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lancedb/lancedb": "0.40.0",
    "apache-arrow": "^18.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "unified": "^11.0.5",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yazl": "^3.3.1"
  },
  "packageManager": "pnpm@11.3.0"
}
