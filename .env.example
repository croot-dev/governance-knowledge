# Values for running on the host (pnpm dev / pnpm *-worker).
# docker compose overrides the addresses and paths that differ inside containers.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://governance:governance@localhost:5432/governance

# ── Storage ─────────────────────────────────────────────────
STORAGE_LANCEDB_URI=./.data/lancedb
# Uploaded originals and extracted content (local PoC store).
STORAGE_ARTIFACT_DIR=./.data/artifacts

# ── Embedding (search) ──────────────────────────────────────
# mock | qwen | nvidia
EMBEDDING_PROVIDER=qwen
# Bump and rebuild when model weights or the indexed text representation change.
EMBEDDING_REVISION=v1
# qwen: Qwen3-Embedding served by the host Ollama app (`ollama pull qwen3-embedding:0.6b`)
EMBEDDING_QWEN_BASE_URL=http://localhost:11434/v1
EMBEDDING_QWEN_MODEL=qwen3-embedding:0.6b
# 0.6B = 1024, 4B = 2560, 8B = 4096
EMBEDDING_QWEN_DIMENSIONS=1024
EMBEDDING_QWEN_API_KEY=
# nvidia: hosted API (see NVIDIA below)
EMBEDDING_NVIDIA_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
EMBEDDING_NVIDIA_DIMENSIONS=2048

# ── OCR · layout description (images, PDF pages) ────────────
# none | ollama | nvidia
OCR_PROVIDER=ollama
# Shared by providers
OCR_MAX_IMAGE_SIDE=1600
OCR_MAX_OUTPUT_TOKENS=4096
# OCR runs on overlapping horizontal strips of this height (px, after resizing), then merges them.
OCR_TILE_HEIGHT=800
OCR_TILE_OVERLAP=64
# ollama: host Ollama app with Metal GPU (`brew services start ollama`).
# Containers reach it via host.docker.internal; this value is for host runs.
OCR_OLLAMA_BASE_URL=http://localhost:11434
OCR_OLLAMA_MODEL=qwen3-vl:2b-instruct-q4_K_M
# Layout description model; empty = OCR_OLLAMA_MODEL.
OCR_OLLAMA_LAYOUT_MODEL=
OCR_OLLAMA_TIMEOUT_MS=300000
OCR_OLLAMA_CONTEXT_TOKENS=8192
# nvidia: hosted vision model (see NVIDIA below)
OCR_NVIDIA_MODEL=qwen/qwen3.5-122b-a10b

# ── PDF ─────────────────────────────────────────────────────
PDF_MAX_PAGES=100
PDF_RENDER_DPI=150

# ── NVIDIA hosted API (shared by embedding and OCR providers) ─
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=90000
# Per-process pacing; the account quota is shared across app and workers.
NVIDIA_REQUEST_INTERVAL_MS=2000
